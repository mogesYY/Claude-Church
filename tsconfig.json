{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noUnusedLocals": false, "noImplicitAny": true, "skipLibCheck": true, "resolveJsonModule": true,
    "esModuleInterop": true, "isolatedModules": true, "types": ["vite/client"]
  },
  "include": ["src"]
}
